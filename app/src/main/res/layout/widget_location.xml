<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/location_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_location_background"
    android:padding="12dp">

    <!-- Content container (shown when there's data) -->
    <LinearLayout
        android:id="@+id/location_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp">

        <!-- Couple Emoji Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- My Emoji -->
            <TextView
                android:id="@+id/location_my_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_location_avatar_bg"
                android:gravity="center"
                android:text="😊"
                android:textSize="20sp" />

            <!-- Heart -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="💕"
                android:textSize="18sp" />

            <!-- Partner Emoji -->
            <TextView
                android:id="@+id/location_partner_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_location_avatar_bg"
                android:gravity="center"
                android:text="🥦"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Distance -->
        <TextView
            android:id="@+id/location_distance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="5.2 km"
            android:textColor="#E91E63"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Partner Location -->
        <TextView
            android:id="@+id/location_partner_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="📍 Q. Bình Thạnh"
            android:textColor="#666666"
            android:textSize="10sp" />

        <!-- Last update -->
        <TextView
            android:id="@+id/location_last_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="5 phút trước"
            android:textColor="#999999"
            android:textSize="9sp" />

        <!-- Hidden views for compatibility -->
        <TextView
            android:id="@+id/location_my_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/location_my_location"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/location_partner_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/location_partner_location"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/location_status"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/location_my_battery"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/location_partner_battery"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Share button -->
    <TextView
        android:id="@+id/location_share_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/circle_pink_background"
        android:gravity="center"
        android:text="📍"
        android:textSize="12sp" />

    <!-- Empty state container -->
    <LinearLayout
        android:id="@+id/location_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💕"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/location_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chưa có vị trí"
            android:textColor="#E91E63"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
