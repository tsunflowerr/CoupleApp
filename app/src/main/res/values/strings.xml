    <string name="faq_link_partner">How do I link with my partner?</string>
    <string name="faq_link_partner_answer">Go to Profile > Manage Link and share your link code with your partner. They can enter your code in their app to connect with you.</string>
    <string name="faq_send_locket">How do I send a Locket?</string>
    <string name="faq_send_locket_answer">Tap on the Locket feature from the home screen or profile. Choose an emoji, text, photo, or drawing to send to your partner.</string>
    <string name="faq_send_locket_question">How do I send a Locket?</string>
    <string name="faq_what_types_question">What types of content can I send?</string>
    <string name="faq_what_types_answer">You can send photos, emoji, drawings, or text messages to your partner.</string>
    <string name="faq_history_question">Where can I see my Locket history?</string>
    <string name="faq_history_answer">Tap the History option in Settings to view all sent and received Lockets.</string>
    <string name="faq_quests">What are Quests?</string>
    <string name="faq_quests_answer">Quests are daily challenges that you and your partner can complete together to earn coins and strengthen your bond.</string>
    <string name="faq_sleep_tracking">How does Sleep Tracking work?</string>
    <string name="faq_sleep_tracking_answer">Enable sleep tracking to monitor your sleep patterns. Share your sleep data with your partner to sync your rest schedules.</string>
    <string name="faq_change_code">Can I change my link code?</string>
    <string name="faq_change_code_answer">Link codes are permanent and cannot be changed. They are unique to your account and help your partner find you.</string>
    <string name="faq_unlink">How do I unlink from my partner?</string>
    <string name="faq_unlink_answer">Go to Profile > Manage Link > Unlink Partner. Note that this will remove all shared data between you and your partner.</string>
    
